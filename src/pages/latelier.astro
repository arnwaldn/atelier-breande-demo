---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Bandeau from '../components/Bandeau.astro';
import dessinProcedes from '../assets/dessins-techniques/suspension.svg?raw';
import dessinVerriere from '../assets/dessins-techniques/verriere.svg?raw';
import dessinRestauration from '../assets/dessins-techniques/restauration.svg?raw';
import MargeActive from '../components/MargeActive.astro';
import ChiffreMarge from '../components/ChiffreMarge.astro';
import CoteMarge from '../components/CoteMarge.astro';
import TitreSection from '../components/TitreSection.astro';
import AppelAction from '../components/AppelAction.astro';
import Visuel from '../components/Visuel.astro';
import ComparateurCoupe from '../components/ComparateurCoupe.astro';
import {
  enTete,
  leLieu,
  familles,
  procedesIntro,
  procedes,
  laLumiere,
  ceQuOnNeFaitPasTitre,
  ceQuOnNeFaitPas,
  ouEtQuand,
  appel,
} from '../data/atelier';
import etabliLarge from '../assets/atelier/etabli-large.jpg';
import matiereLaiton from '../assets/atelier/matiere-laiton.jpg';
import matiereVerre from '../assets/atelier/matiere-verre.jpg';
import matiereBois from '../assets/atelier/matiere-bois.jpg';
import matiereAcier from '../assets/atelier/matiere-acier.jpg';
import coupePhoto from '../assets/atelier/coupe-photo.jpg';
import coupeDessin from '../assets/atelier/coupe-dessin.jpg';

const imagesFamilles: Record<string, { image: ImageMetadata; alt: string }> = {
  'Laiton et cuivre': { image: matiereLaiton, alt: 'Chutes et pièces de laiton brossé, verni et patiné, rangées sur l’établi' },
  Verre: { image: matiereVerre, alt: 'Globes de verre soufflé clairs, ambrés et fumés, alignés à contre-jour' },
  Bois: { image: matiereBois, alt: 'Plateaux de noyer et de chêne massif empilés, prêts à sécher' },
  'Acier et finitions': { image: matiereAcier, alt: 'Pièces d’acier thermolaqué noir texturé et fonte brute pour bases de lampadaire' },
};
---
<BaseLayout
  title="L’atelier — Atelier Bréande (site de démonstration)"
  description="Site de démonstration : Atelier Bréande est un atelier fictif. Les matières, les procédés et la lumière — comment une pièce naît, du dessin à l’essai en charge."
  heroPleinEcran
>
  {/* B1 — SEUIL COURT. Image plein-bord, 46svh, PRIORITAIRE.
      Corrigé le 20/08/2026 : le commentaire précédent disait « pas le LCP du
      site (seul le hero de l'accueil l'est) ». Faux — le LCP se calcule PAR
      PAGE. PageSpeed désigne cette image comme l'élément LCP de /latelier, et
      la servir en lazy en faisait la page la plus lente du site (LCP 2,0 s
      contre 1,2 s sur une fiche de pièce). Même erreur de portée que celle
      déjà corrigée le 19/08 pour les animations : la règle avait été lue comme
      ne visant que l'accueil. */}
  <section class="seuil-secondaire" data-jour="1">
    <div class="seuil-secondaire__image">
      <Visuel
        src={etabliLarge}
        alt="L’établi principal de l’atelier, vu de face, avec ses outils rangés à portée de main"
        sizes="100vw"
        widths={[480, 900, 1400, 1920]}
        prioritaire
      />
    </div>
    <div class="seuil-secondaire__voile" aria-hidden="true"></div>
    <div class="seuil-secondaire__corps">
      <div class="mx-auto max-w-[108rem] px-4 sm:px-8 md:px-12">
        <h1 class="titre-wonk max-w-2xl text-breande-paper text-[length:var(--t-section)]">{enTete.titre}</h1>
        <p class="mesure-large mt-4 text-breande-paper/85">{enTete.chapo}</p>
      </div>
    </div>
  </section>

  {/* B2 — LE LIEU. La marge recoit LE CHIFFRE QUI SE LEVE : trois dates et
      un effectif, tous LUS dans les quatre paragraphes a gauche — la colonne
      ne dit rien de neuf, elle souligne (voir MargeActive.astro). */}
  <MargeActive intitule="l’atelier">
    <Bandeau jour={2}>
      <div class="mesure text-breande-muted" data-revelation>
        {leLieu.map((p) => <p class="mt-4 first:mt-0">{p}</p>)}
      </div>
    </Bandeau>
    <div slot="marge" data-revelation>
      <ChiffreMarge
        chiffres={[
          { valeur: '2011', legende: 'installés dans l’ancienne imprimerie' },
          { valeur: '2016', legende: 'le tour à repousser, acheté d’occasion' },
          { valeur: 'trois', legende: 'personnes à l’atelier' },
        ]}
      />
    </div>
  </MargeActive>

  {/* B3 — LES QUATRE FAMILLES DE MATIÈRES */}
  <Bandeau jour={2} ariaLabelledby="titre-matieres">
    <TitreSection texte="Les matières" id="titre-matieres" filet />
    {/* LA LUMIÈRE RASANTE (lot « lumière » du 19/08 au soir) — un balayage
        traverse chaque photo, une matière après l'autre, voir
        demarrerLumiereRasante() dans effets-scroll.ts et
        .famille-matiere__image::after dans global.css. */}
    <div class="grille-matieres mt-10" data-lumiere-rasante>
      {
        familles.map((famille, i) => {
          const visuel = imagesFamilles[famille.titre];
          return (
            <div data-revelation class:list={[`cascade-${i + 1}`]}>
              {visuel && (
                <div class="famille-matiere__image">
                  <Visuel src={visuel.image} alt={visuel.alt} sizes="(min-width: 768px) 40vw, 90vw" />
                </div>
              )}
              <p class="famille-matiere__titre">{famille.titre}</p>
              <p class="text-breande-muted">{famille.texte}</p>
            </div>
          );
        })
      }
    </div>
  </Bandeau>

  {/* B4 — LES PROCÉDÉS, en frise verticale numérotée */}
  <Bandeau jour={3} ariaLabelledby="titre-procedes">
    <TitreSection texte="Les procédés" id="titre-procedes" filet />
    <p class="mesure mt-4 text-breande-muted">{procedesIntro}</p>
    {/* Le dessin reste en face pendant qu'on descend les huit gestes. Relevé du
        20/08/2026 : ce bloc faisait 2 008 px sans une seule image, 14 à 16 %
        d'occupation d'écran sur trois écrans d'affilée, avec toute la moitié
        droite vide — le plus profond creux de la page la plus creuse du site.
        Le dessin technique EST le sujet du texte (01 Dessin, 05 Dessin
        d'exécution) et il existe déjà dans le dépôt : poids nul, trait de
        laiton, aucune image à produire. */}
    <div class="procedes-avec-dessin mt-8">
      <div class="frise-procedes" data-revelation>
      {
        procedes.map((procede) => (
          <div class="frise-procede">
            <span class="frise-procede__numero" aria-hidden="true">
              {String(procede.numero).padStart(2, '0')}
            </span>
            <div>
              <p class="frise-procede__titre">{procede.titre}</p>
              <p class="frise-procede__texte">{procede.texte}</p>
            </div>
          </div>
        ))
      }
      </div>
      {/* data-dessin-technique n'est PAS decoratif : c'est lui que
          demarrerDessinTechnique() cherche (effets-scroll.ts) pour poser
          --dessin-progres. Sans lui, le CSS laisse stroke-dashoffset a sa
          valeur de repli (1), soit un trait entierement decale : le SVG est
          dans le DOM, visible, opacite 1... et ne trace AUCUN trait. Oubli du
          20/08/2026, trouve a l'ecran : un tiers de la largeur reste noir sur
          1 578 px de haut, et la page ne gagne pas un point d'occupation. */}
      <aside
        class="procedes-dessin"
        aria-hidden="true"
        data-dessin-technique
        set:html={dessinProcedes}
      />
    </div>
  </Bandeau>

  {/* B5 — LA LUMIÈRE */}
  <Bandeau jour={3} ariaLabelledby="titre-lumiere">
    <TitreSection texte={laLumiere.titre} id="titre-lumiere" filet />
    <div class="mesure mt-4 text-breande-muted" data-revelation>
      {laLumiere.texte.map((p) => <p class="mt-3 first:mt-0">{p}</p>)}
    </div>
    <table class="tableau-lumiere mt-8" data-revelation>
      <caption>Repère de température et d’intensité par pièce du logement.</caption>
      <thead>
        <tr>
          <th scope="col">pièce</th>
          <th scope="col">température</th>
          <th scope="col">intensité par point</th>
        </tr>
      </thead>
      <tbody>
        {
          laLumiere.tableau.map((ligne) => (
            <tr>
              <th scope="row">{ligne.piece}</th>
              <td>{ligne.temperature}</td>
              <td>{ligne.intensite}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="mesure mt-6 text-breande-muted">{laLumiere.note}</p>
  </Bandeau>

  {/* LA COUPE DE MATIÈRE — moment de bravoure n°3, passé en plein-bord
      (recette DA du 19/08 : 640 px dans une page de 1280, ~590 px de vide à
      droite — le geste existait déjà, il lui manquait l'ampleur). Le
      comparateur reste un geste VOLONTAIRE porté par le curseur natif ; le
      seul ajout est un balayage D'ENTRÉE, une fois, qui rend ensuite la main
      — voir demarrerComparateurCoupe() dans effets-scroll.ts. Pas de scrub :
      le défilement fait la démonstration, il ne confisque pas le geste. */}
  <Bandeau jour={4} pleinBord="droite" ariaLabelledby="titre-coupe">
    <div class="coupe-travee">
      <div>
        <TitreSection texte="La coupe de matière" id="titre-coupe" filet />
        <p class="mesure mt-4 text-breande-muted">
          D’un côté la pièce photographiée, de l’autre le dessin technique qui l’a précédée —
          c’est le même objet, à deux moments du même geste.
        </p>
      </div>
      <div class="bandeau__deborde-droite" data-revelation>
        <ComparateurCoupe
          photo={coupePhoto}
          photoAlt="Photo d’une suspension en laiton et verre soufflé, allumée"
          dessin={coupeDessin}
          dessinAlt="Dessin technique au trait de la même suspension, coté et annoté"
          class="comparateur-coupe--large"
        />
        {/* C16 (recette DA du 19/08) : le dessin technique porte des lignes de
            cote sans valeurs — l'image n'est pas modifiable dans ce chantier,
            la légende donne donc les deux cotes réelles (fiche doucine). */}
        <p class="etiquette mt-4">Ø 240 mm · verre soufflé — H 214 mm, monture laiton</p>
      </div>
    </div>
  </Bandeau>

  {/* B6 — CE QUI SE FAIT AILLEURS. La marge recoit LE TRAIT QUI SE TRACE,
      le geste que le client a explicitement aime sur les fiches de piece. */}
  <MargeActive>
    <Bandeau jour={4} ariaLabelledby="titre-ailleurs">
      <TitreSection texte={ceQuOnNeFaitPasTitre} id="titre-ailleurs" filet />
      <div class="mesure mt-4 text-breande-muted" data-revelation>
        {ceQuOnNeFaitPas.map((p) => <p class="mt-3 first:mt-0">{p}</p>)}
      </div>
    </Bandeau>
    <div slot="marge" data-dessin-technique set:html={dessinRestauration} />
  </MargeActive>

  {/* B7 — OÙ, ET QUAND. La marge recoit LA COTE QUI S'ECRIT : trois reperes
      d'ouverture, tous presents dans la phrase a gauche. */}
  <MargeActive intitule="ouverture">
    <Bandeau jour={5} ariaLabelledby="titre-ou-quand">
      <TitreSection texte={ouEtQuand.titre} id="titre-ou-quand" filet />
      <p class="mesure mt-4 text-breande-muted" data-revelation>{ouEtQuand.texte}</p>
    </Bandeau>
    <div slot="marge" data-revelation>
      <CoteMarge
        cotes={[
          { valeur: 'mardi — vendredi', legende: 'sur rendez-vous' },
          { valeur: 'samedi matin', legende: 'quand c’est le seul créneau' },
          { valeur: 'trois semaines', legende: 'fermeture d’août' },
        ]}
      />
    </div>
  </MargeActive>

  {/* B8 — APPEL */}
  <Bandeau jour={5} air="large">
    <div class="border-t border-[rgb(138_107_74_/_0.25)] pt-10" data-revelation>
      <p class="mesure text-lg text-breande-paper">{appel.texte}</p>
      <div class="mt-6">
        <AppelAction texte={appel.bouton} href={appel.href} variante="plein" />
      </div>
    </div>
  </Bandeau>
</BaseLayout>
