---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bandeau from '../components/Bandeau.astro';
import MargeActive from '../components/MargeActive.astro';
import dessinEtabli from '../assets/dessins-techniques/etabli.svg?raw';
import TitreSection from '../components/TitreSection.astro';
import ChiffreCle from '../components/ChiffreCle.astro';
import CartePiece from '../components/CartePiece.astro';
import AppelAction from '../components/AppelAction.astro';
import Visuel from '../components/Visuel.astro';
import RubanGestes from '../components/RubanGestes.astro';
import { getEntry } from 'astro:content';
import {
  titreSeuil,
  chapeau,
  reperes,
  phraseSeule,
  entreesMetier,
  titrePiecesRecentes,
  piecesMisesEnAvant,
  chantier,
  bandeauBasculement,
  ouEtRythme,
  ceQueNousNeFaisonsPas,
  etabli,
  appelFinal,
} from '../data/accueil';
import imageCreation from '../assets/services/creation.jpg';
import imageRestauration from '../assets/services/restauration.jpg';
import imageConseil from '../assets/services/conseil.jpg';
import imageChantier from '../assets/pieces/cerce/ambiance.jpg';
import imageHero from '../assets/hero/hero-atelier.webp';

const imagesGestes = {
  Créer: { image: imageCreation, alt: 'Croquis à l’échelle 1 et gabarit de carton, punaisés au mur de l’atelier' },
  Restaurer: { image: imageRestauration, alt: 'Suspension ancienne démontée sur l’établi, câblage textile déposé' },
  Conseiller: { image: imageConseil, alt: 'Plan d’éclairage annoté et ampoules d’essai posées sur une table' },
};

const gestesDuRuban = entreesMetier.map((entree) => ({
  ...entree,
  ...imagesGestes[entree.titre as keyof typeof imagesGestes],
}));

const piecesVedettes = await Promise.all(
  piecesMisesEnAvant.map((slug) => getEntry('pieces', slug))
);
---
<BaseLayout
  title="Atelier Bréande — luminaires sur mesure, Lyon (site de démonstration)"
  description="Site de démonstration : Atelier Bréande est un atelier fictif. Création, restauration et conseil éclairage à Lyon — dessinés et fabriqués à l’établi, pour un endroit précis."
  heroPleinEcran
>
  {/* 1 — LE SEUIL. C'est le LCP, mesuré à 97 : elle ne porte aucune animation
      propre (seul le texte change), reste prioritaire et passe par
      Visuel.astro comme toute image du projet (importante 5 du chantier
      bêta du 19/08 : servie 85 Ko à l'identique à 360 px avant cette
      correction — voir le rapport de chantier pour la mesure avant/après). */}
  <section class="allumage relative overflow-hidden" aria-label="L’atelier" data-jour="1">
    <Visuel
      src={imageHero}
      alt="L’établi de l’atelier le soir : pièces de laiton, globes de verre soufflé et une suspension allumée qui éclaire le plan de travail"
      prioritaire
      sizes="100vw"
      widths={[480, 800, 1200, 1600, 2048]}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-breande-night via-breande-night/45 to-breande-night/10"
      aria-hidden="true"
    ></div>
    {/* LE SEUIL QUI SE RETIRE (lot « lumière » du 19/08 au soir) — la photo
        (le LCP) ne bouge jamais ; seul ce calque de titre se retire sur les
        400 premiers pixels de défilement, voir demarrerSeuilTitre() dans
        effets-scroll.ts et --seuil-titre-opacite/-y dans global.css. */}
    <div data-seuil-titre class="relative mx-auto flex min-h-[max(72vh,480px)] max-w-[108rem] flex-col justify-end px-4 pt-40 pb-12 sm:px-8 sm:pt-32 md:px-12 md:pb-16">
      <h1 class="titre-wonk max-w-3xl text-breande-paper text-[length:var(--t-seuil)] leading-[1.02]">
        {titreSeuil[0]}<br />{titreSeuil[1]}<br />{titreSeuil[2]}
      </h1>
      <p class="mesure-large mt-5 text-base text-breande-paper/85 sm:text-lg">{chapeau}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <AppelAction texte={appelFinal.bouton} href={appelFinal.href} variante="plein" />
        <AppelAction texte={appelFinal.boutonSecondaire} href={appelFinal.hrefSecondaire} variante="filet" />
      </div>
      <p class="mt-8 max-w-md text-[0.8125rem] leading-relaxed text-breande-paper/90">
        Image produite par intelligence artificielle. Atelier Bréande n’existe pas :
        ni ce lieu, ni ces objets, ni cette scène ne sont réels.
      </p>
    </div>
  </section>

  {/* 2 — LES REPÈRES */}
  <Bandeau jour={1} ariaLabel="Repères de l’atelier">
    <div class="grille-reperes">
      {
        reperes.map((r, i) => (
          <div data-revelation class:list={[`cascade-${i + 1}`]}>
            <ChiffreCle valeur={r.valeur} libelle={r.libelle} />
          </div>
        ))
      }
    </div>
  </Bandeau>

  {/* 3 — LA PHRASE SEULE */}
  <Bandeau jour={2}>
    <p class="phrase-seule" data-revelation>{phraseSeule}</p>
  </Bandeau>

  {/* 4 — LES TROIS GESTES : le ruban horizontal (voir RubanGestes.astro),
      geste signature transposé de la référence qiqiglobal.com. */}
  <RubanGestes gestes={gestesDuRuban} jour={3} ariaLabel="Les trois gestes de l’atelier : créer, restaurer, conseiller" />

  {/* 5 — LE CHANTIER RACONTÉ. jour={4} et non {3} (recette DA du 19/08) : le
      ruban qui précède interpole maintenant --part-de-jour EN CONTINU
      jusqu'à 0,30 pendant sa propre traversée (voir effets-scroll.ts) — ce
      bandeau doit repartir exactement là où le geste l'a laissé, jamais
      remonter d'un palier. */}
  <Bandeau jour={4} ariaLabelledby="titre-chantier">
    <div class="chantier-raconte">
      <div class="chantier-raconte__image" data-revelation>
        <Visuel
          src={imageChantier}
          alt="La salle à manger sous verrière, le cercle de laiton allumé au-dessus de la table"
          sizes="(min-width: 900px) 50vw, 100vw"
        />
      </div>
      <div class="chantier-raconte__corps" data-revelation>
        <TitreSection texte={chantier.titre} id="titre-chantier" />
        <div class="mesure-large mt-4 text-breande-muted">
          {chantier.paragraphes.map((p) => <p>{p}</p>)}
        </div>
        <a href={chantier.lienHref} class="etiquette mt-6 inline-block">{chantier.lienTexte}</a>
      </div>
    </div>
  </Bandeau>

  {/* 6 — LE BANDEAU DE BASCULEMENT */}
  <Bandeau jour={4}>
    <div class="bandeau-basculement">
      <p class="bandeau-basculement__texte" data-revelation>{bandeauBasculement}</p>
    </div>
  </Bandeau>

  {/* 8 — PIÈCES MISES EN AVANT, ce que nous ne faisons pas, appel final.
      Corrige le 20/08/2026 : elle etait a jour={4}, donc la page REMONTAIT en
      temperature juste avant l'appel a l'action, a l'exact oppose de l'ADR-002
      (« il ne reste que 2 700 K au moment precis ou l'on demande d'ecrire »).
      La section 7 portait le seul palier 5 de la page ; il lui revient. */}
  <Bandeau jour={5} air="large" ariaLabelledby="titre-pieces-recentes">
    <TitreSection texte={titrePiecesRecentes} id="titre-pieces-recentes" filet />
    <div class="mt-10 grid gap-8 md:grid-cols-3" data-grille-pieces>
      {
        piecesVedettes.map((piece, i) => piece && (
          <div
            data-revelation
            {/* Le col-span-2 sur la premiere carte est retire le 20/08/2026 :
                avec TROIS pieces, il laissait la seconde rangee avec une seule
                carte de 420 px dans une rangee de 1 328 — un vide mesure a
                960 x 800 px, l'un des plus grands de la page. Trois cartes
                egales tiennent une rangee pleine. */}
            class:list={[`cascade-${i + 1}`]}
          >
            <CartePiece
              nom={piece.data.nom}
              href={`/collections/${piece.id}`}
              image={piece.data.image}
              imageAlt={piece.data.imageAlt}
              matieres={piece.data.matieres}
              prix={piece.data.prix}
              delaiCourant={piece.data.delaiCourant}
            />
          </div>
        ))
      }
    </div>
  </Bandeau>

  {/* 9 — LA MATIÈRE ET L'ÉTABLI, et ce que nous ne faisons pas.
      Le bloc `etabli` était écrit dans data/accueil.ts depuis l'origine,
      exporté, et JAMAIS importé par cette page : 480 signes sur les copeaux
      de laiton et le tour à repousser, qui n'existaient nulle part. Il tient
      ici sa place naturelle — la dernière chose qu'on raconte avant de
      demander d'écrire. La marge reçoit LE TRAIT QUI SE TRACE : l'élévation
      cotée de l'établi, dessin créé pour l'occasion. */}
  <MargeActive intitule="l’établi">
    <Bandeau jour={5} air="serie">
      <div class="mesure" data-revelation>
        <TitreSection texte={etabli.titre} />
        <p class="mt-4 text-breande-muted">{etabli.texte}</p>
        <p class="etiquette mt-5"><a href={etabli.lienHref}>{etabli.lienTexte}</a></p>
      </div>

      <div class="mesure mt-16" data-revelation>
        <TitreSection texte={ceQueNousNeFaisonsPas.titre} />
        <p class="mt-4 text-breande-muted">{ceQueNousNeFaisonsPas.texte}</p>
      </div>

      <div class="mesure mt-10 border-l-2 border-breande-brass/40 pl-5" data-revelation>
        <p class="text-breande-muted">{ouEtRythme.texte}</p>
      </div>
    </Bandeau>
    <div slot="marge" data-dessin-technique set:html={dessinEtabli} />
  </MargeActive>

  <Bandeau jour={5} air="serie">
    <div class="border-t border-[rgb(138_107_74_/_0.25)] pt-10" data-revelation>
      <p class="mesure text-lg text-breande-paper">{appelFinal.texte}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <AppelAction texte={appelFinal.bouton} href={appelFinal.href} variante="plein" />
        <AppelAction texte={appelFinal.boutonSecondaire} href={appelFinal.hrefSecondaire} variante="filet" />
      </div>
    </div>
  </Bandeau>
</BaseLayout>
