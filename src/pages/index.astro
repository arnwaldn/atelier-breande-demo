---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bandeau from '../components/Bandeau.astro';
import TitreSection from '../components/TitreSection.astro';
import ChiffreCle from '../components/ChiffreCle.astro';
import CartePiece from '../components/CartePiece.astro';
import BandeScene from '../components/BandeScene.astro';
import AppelAction from '../components/AppelAction.astro';
import Visuel from '../components/Visuel.astro';
import { getEntry } from 'astro:content';
import {
  titreSeuil,
  chapeau,
  reperes,
  phraseSeule,
  entreesMetier,
  titrePiecesRecentes,
  piecesMisesEnAvant,
  chantier,
  bandeauBasculement,
  ouEtRythme,
  ceQueNousNeFaisonsPas,
  appelFinal,
} from '../data/accueil';
import imageCreation from '../assets/services/creation.jpg';
import imageRestauration from '../assets/services/restauration.jpg';
import imageConseil from '../assets/services/conseil.jpg';
import imageChantier from '../assets/pieces/cerce/ambiance.jpg';
import imageRepli from '../assets/repli/luminaire-repli.jpg';

const imagesGestes = {
  Créer: { image: imageCreation, alt: 'Croquis à l’échelle 1 et gabarit de carton, punaisés au mur de l’atelier' },
  Restaurer: { image: imageRestauration, alt: 'Suspension ancienne démontée sur l’établi, câblage textile déposé' },
  Conseiller: { image: imageConseil, alt: 'Plan d’éclairage annoté et ampoules d’essai posées sur une table' },
};

const piecesVedettes = await Promise.all(
  piecesMisesEnAvant.map((slug) => getEntry('pieces', slug))
);
---
<BaseLayout
  title="Atelier Bréande — luminaires sur mesure, Lyon (site de démonstration)"
  description="Site de démonstration : Atelier Bréande est un atelier fictif. Création, restauration et conseil éclairage à Lyon — dessinés et fabriqués à l’établi, pour un endroit précis."
  heroPleinEcran
>
  {/* 1 — LE SEUIL. L'image reste en <img> direct : c'est le LCP, mesuré à 97,
      elle ne porte aucune animation propre. Seul le texte change. */}
  <section class="allumage relative overflow-hidden" aria-label="L’atelier" data-jour="1">
    <img
      src="/images/hero-atelier.webp"
      alt="L’établi de l’atelier le soir : pièces de laiton, globes de verre soufflé et une suspension allumée qui éclaire le plan de travail"
      width="2048"
      height="1152"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-breande-night via-breande-night/45 to-breande-night/10"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto flex min-h-[max(72vh,480px)] max-w-[108rem] flex-col justify-end px-4 pt-40 pb-12 sm:px-8 sm:pt-32 md:px-12 md:pb-16">
      <h1 class="titre-wonk max-w-3xl text-breande-paper text-[length:var(--t-seuil)] leading-[1.02]">
        {titreSeuil[0]}<br />{titreSeuil[1]}<br />{titreSeuil[2]}
      </h1>
      <p class="mesure-large mt-5 text-base text-breande-paper/85 sm:text-lg">{chapeau}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <AppelAction texte={appelFinal.bouton} href={appelFinal.href} variante="plein" />
        <AppelAction texte={appelFinal.boutonSecondaire} href={appelFinal.hrefSecondaire} variante="filet" />
      </div>
      <p class="mt-8 max-w-md text-xs leading-relaxed text-breande-paper/55">
        Image produite par intelligence artificielle. Atelier Bréande n’existe pas :
        ni ce lieu, ni ces objets, ni cette scène ne sont réels.
      </p>
    </div>
  </section>

  {/* 2 — LES REPÈRES */}
  <Bandeau jour={1} ariaLabel="Repères de l’atelier">
    <div class="grille-reperes">
      {
        reperes.map((r, i) => (
          <div data-revelation class:list={[`cascade-${i + 1}`]}>
            <ChiffreCle valeur={r.valeur} libelle={r.libelle} />
          </div>
        ))
      }
    </div>
  </Bandeau>

  {/* 3 — LA PHRASE SEULE */}
  <Bandeau jour={2}>
    <p class="phrase-seule" data-revelation>{phraseSeule}</p>
  </Bandeau>

  {/* 4 — LES TROIS GESTES : trois travées plein-bord, alternées, data-jour
      descendant. */}
  {
    entreesMetier.map((entree, i) => {
      const cote = i % 2 === 0 ? 'droite' : 'gauche';
      const visuel = imagesGestes[entree.titre as keyof typeof imagesGestes];
      const palier = (2 + Math.min(i, 1)) as 2 | 3;
      return (
        <Bandeau jour={palier} pleinBord={cote} ariaLabelledby={`geste-${entree.titre}`}>
          <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
            <div
              class:list={[
                'aspect-[4/3] overflow-hidden rounded-sm shadow-[var(--recoit-lumiere)]',
                cote === 'droite' ? 'md:order-1' : 'md:order-2',
              ]}
            >
              <Visuel
                src={visuel.image}
                alt={visuel.alt}
                sizes="(min-width: 768px) 50vw, 100vw"
                class="h-full w-full object-cover"
              />
            </div>
            <div data-revelation class:list={[cote === 'droite' ? 'md:order-2' : 'md:order-1']}>
              <TitreSection texte={entree.titre} id={`geste-${entree.titre}`} />
              <p class="mesure mt-4 text-breande-muted">{entree.texte}</p>
              <a href={entree.lienHref} class="etiquette mt-6 inline-block">{entree.lienTexte}</a>
            </div>
          </div>
        </Bandeau>
      );
    })
  }

  {/* 5 — LE CHANTIER RACONTÉ */}
  <Bandeau jour={3} ariaLabelledby="titre-chantier">
    <div class="chantier-raconte">
      <div class="chantier-raconte__image" data-revelation>
        <Visuel
          src={imageChantier}
          alt="La salle à manger sous verrière, le cercle de laiton allumé au-dessus de la table"
          sizes="(min-width: 900px) 50vw, 100vw"
        />
      </div>
      <div class="chantier-raconte__corps" data-revelation>
        <TitreSection texte={chantier.titre} id="titre-chantier" />
        <div class="mesure-large mt-4 text-breande-muted">
          {chantier.paragraphes.map((p) => <p>{p}</p>)}
        </div>
        <a href={chantier.lienHref} class="etiquette mt-6 inline-block">{chantier.lienTexte}</a>
      </div>
    </div>
  </Bandeau>

  {/* 6 — LE BANDEAU DE BASCULEMENT */}
  <Bandeau jour={4}>
    <div class="bandeau-basculement">
      <p class="bandeau-basculement__texte" data-revelation>{bandeauBasculement}</p>
    </div>
  </Bandeau>

  {/* 7 — LA PIÈCE QUE L'ON RÈGLE — à plus de 2 400 px sous la flottaison. */}
  <Bandeau jour={5} ariaLabel="Régler la lumière">
    <div data-revelation>
      <BandeScene>
        <Visuel
          src={imageRepli}
          alt="Une suspension en laiton et verre soufflé, allumée, présentée sur fond neutre"
          sizes="(min-width: 900px) 60vw, 100vw"
        />
      </BandeScene>
    </div>
  </Bandeau>

  {/* 8 — PIÈCES MISES EN AVANT, ce que nous ne faisons pas, appel final. */}
  <Bandeau jour={4} ariaLabelledby="titre-pieces-recentes">
    <TitreSection texte={titrePiecesRecentes} id="titre-pieces-recentes" filet />
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {
        piecesVedettes.map((piece, i) => piece && (
          <div
            data-revelation
            class:list={[`cascade-${i + 1}`, i === 0 && 'md:col-span-2']}
          >
            <CartePiece
              nom={piece.data.nom}
              href={`/collections/${piece.id}`}
              image={piece.data.image}
              imageAlt={piece.data.imageAlt}
              matieres={piece.data.matieres}
              prix={piece.data.prix}
              delaiCourant={piece.data.delaiCourant}
            />
          </div>
        ))
      }
    </div>

    <div class="mesure-large mt-16" data-revelation>
      <TitreSection texte={ceQueNousNeFaisonsPas.titre} />
      <p class="mt-4 text-breande-muted">{ceQueNousNeFaisonsPas.texte}</p>
    </div>

    <div class="mesure-large mt-10 border-l-2 border-breande-brass/40 pl-5" data-revelation>
      <p class="text-breande-muted">{ouEtRythme.texte}</p>
    </div>

    <div class="mt-16 border-t border-[rgb(138_107_74_/_0.25)] pt-10" data-revelation>
      <p class="mesure text-lg text-breande-paper">{appelFinal.texte}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <AppelAction texte={appelFinal.bouton} href={appelFinal.href} variante="plein" />
        <AppelAction texte={appelFinal.boutonSecondaire} href={appelFinal.hrefSecondaire} variante="filet" />
      </div>
    </div>
  </Bandeau>
</BaseLayout>
