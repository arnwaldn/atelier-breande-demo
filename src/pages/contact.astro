---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout
  title="Contact — Atelier Bréande (site de démonstration)"
  description="Site de démonstration : Atelier Bréande est un atelier fictif. Le formulaire de cette page est désactivé : aucun message n’est transmis."
>
  <section class="py-12">
    <h1 class="text-4xl">Contact</h1>
    <p class="mt-4 max-w-xl text-lg text-breande-muted">
      Parlez-nous de votre projet : une pièce à créer, un luminaire à restaurer,
      une ambiance à composer. Nous vous répondons rapidement.
    </p>
    <div class="mt-10">
      <ContactForm />
    </div>
  </section>
</BaseLayout>
