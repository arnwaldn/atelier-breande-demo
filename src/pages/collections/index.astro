---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bandeau from '../../components/Bandeau.astro';
import TitreSection from '../../components/TitreSection.astro';
import CartePiece from '../../components/CartePiece.astro';
import EtiquetteTechnique from '../../components/EtiquetteTechnique.astro';
import AppelAction from '../../components/AppelAction.astro';
import Visuel from '../../components/Visuel.astro';
import { getCollection } from 'astro:content';
import { collectionsEnTete, typologies, relance, passerelleServices } from '../../data/collections';

const toutesLesPieces = await getCollection('pieces');
const pieces = toutesLesPieces.sort((a, b) => a.data.ordre - b.data.ordre);
const parSlug = Object.fromEntries(pieces.map((p) => [p.id, p]));

// Composition manuelle : deux rangées contenues, deux rangées plein-bord en
// alternant le côté (jamais les deux à la fois — ADR direction artistique).
const rangeeA = ['traboule', 'imposte'].map((s) => parSlug[s]);
const grandeGauche = parSlug['cerce'];
const rangeeB = ['larmier', 'doucine', 'encorbellement'].map((s) => parSlug[s]);
const grandeDroite = parSlug['suspension-1930'];
---
<BaseLayout
  title="Les pièces — Atelier Bréande (site de démonstration)"
  description="Site de démonstration : Atelier Bréande est un atelier fictif. Sept pièces sorties de l’atelier, avec leur prix et leur délai — suspensions, appliques, lampes et une restauration."
>
  <Bandeau jour={1}>
    <h1 class="titre-wonk max-w-2xl text-breande-paper text-[length:var(--t-section)]">
      {collectionsEnTete.titre}
    </h1>
    <p class="mesure-large mt-4 text-breande-muted">{collectionsEnTete.chapo}</p>
    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2" aria-label="Typologies">
      {
        typologies.map((t) => (
          <li>
            <span class="etiquette">{t.libelle}</span>
          </li>
        ))
      }
    </ul>
  </Bandeau>

  <Bandeau jour={2}>
    <div class="grille-collections" data-grille-pieces>
      {
        rangeeA.map((piece, i) => piece && (
          <div data-revelation class:list={[`cascade-${i + 1}`, i === 0 && 'sm:col-span-2']}>
            <CartePiece
              sizes="(min-width: 640px) 31vw, 45vw"
              nom={piece.data.nom}
              href={`/collections/${piece.id}`}
              image={piece.data.image}
              imageAlt={piece.data.imageAlt}
              matieres={piece.data.matieres}
              prix={piece.data.prix}
              delaiCourant={piece.data.delaiCourant}
              prioritaire={i === 0}
            />
          </div>
        ))
      }
    </div>
  </Bandeau>

  {
    grandeGauche && (
      <Bandeau jour={2} pleinBord="gauche" ariaLabel={`La pièce ${grandeGauche.data.nom}`}>
        <div class="carte-piece-large" data-revelation>
          {/* Le geste signature de cette page (recette DA du 19/08) : le
              cadre s'ouvre en clip-path, de gauche à droite — voir
              .carte-piece-large[data-revele] .carte-piece-large__cadre dans
              global.css. Piloté par le data-revele DU PARENT (celui-ci,
              juste au-dessus), jamais un data-revelation propre au cadre :
              un élément à clip-path de surface nulle n'est plus considéré
              « intersectant » par l'IntersectionObserver de Chromium — un
              second observateur sur le cadre ne se serait donc JAMAIS
              déclenché (piège vérifié en recette du 19/08, capture à
              l'appui). Même déclencheur, un seul écrivain. */}
          <a href={`/collections/${grandeGauche.id}`} class="carte-piece-large__cadre bandeau__deborde-gauche" data-piece-photo={grandeGauche.id}>
            <Visuel
              src={grandeGauche.data.image}
              alt={grandeGauche.data.imageAlt}
              sizes="(min-width: 768px) 55vw, 100vw"
            />
          </a>
          <div>
            <EtiquetteTechnique items={grandeGauche.data.matieres} />
            <a href={`/collections/${grandeGauche.id}`} class="carte-piece-large__nom mt-2 block">
              {grandeGauche.data.nom}
            </a>
            <p class="mesure mt-3 text-breande-muted">{grandeGauche.data.chapo}</p>
            <p class="carte-piece-large__specs">
              <span>à partir de {grandeGauche.data.prix}</span>
              <span>{grandeGauche.data.delaiCourant}</span>
            </p>
          </div>
        </div>
      </Bandeau>
    )
  }

  <Bandeau jour={3}>
    <div class="grille-collections" data-grille-pieces>
      {
        rangeeB.map((piece, i) => piece && (
          <div data-revelation class:list={[`cascade-${i + 1}`]}>
            <CartePiece
              sizes="(min-width: 640px) 31vw, 45vw"
              nom={piece.data.nom}
              href={`/collections/${piece.id}`}
              image={piece.data.image}
              imageAlt={piece.data.imageAlt}
              matieres={piece.data.matieres}
              prix={piece.data.prix}
              delaiCourant={piece.data.delaiCourant}
            />
          </div>
        ))
      }
    </div>
  </Bandeau>

  {
    grandeDroite && (
      <Bandeau jour={4} pleinBord="droite" ariaLabel={`La pièce ${grandeDroite.data.nom}`}>
        <div class="carte-piece-large" data-revelation>
          <div class="md:order-2">
            <a href={`/collections/${grandeDroite.id}`} class="carte-piece-large__cadre bandeau__deborde-droite" data-piece-photo={grandeDroite.id}>
              <Visuel
                src={grandeDroite.data.image}
                alt={grandeDroite.data.imageAlt}
                sizes="(min-width: 768px) 55vw, 100vw"
              />
            </a>
          </div>
          <div class="md:order-1">
            <EtiquetteTechnique items={grandeDroite.data.matieres} />
            <a href={`/collections/${grandeDroite.id}`} class="carte-piece-large__nom mt-2 block">
              {grandeDroite.data.nom}
            </a>
            <p class="mesure mt-3 text-breande-muted">{grandeDroite.data.chapo}</p>
            <p class="carte-piece-large__specs">
              <span>à partir de {grandeDroite.data.prix}</span>
              <span>{grandeDroite.data.delaiCourant}</span>
            </p>
          </div>
        </div>
      </Bandeau>
    )
  }

  <Bandeau jour={5} air="large">
    <div class="border-t border-[rgb(138_107_74_/_0.25)] pt-10" data-revelation>
      <TitreSection texte={relance.titre} />
      <p class="mesure mt-4 text-breande-muted">{relance.texte}</p>
      <div class="mt-6">
        <AppelAction texte={relance.bouton} href={relance.href} variante="plein" />
      </div>
    </div>
    <div class="mt-10 border-l-2 border-breande-brass/40 pl-5" data-revelation>
      <p class="mesure text-breande-muted">
        {passerelleServices.texte}
        {' '}
        <a href={passerelleServices.href} class="etiquette">{passerelleServices.bouton}</a>
      </p>
    </div>
  </Bandeau>
</BaseLayout>
