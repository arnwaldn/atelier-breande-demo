---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  heroPleinEcran?: boolean; // accueil : le header se pose sur l'image
}
const { title, description, heroPleinEcran = false } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <SeoHead title={title} description={description} />
  </head>
  <body class="grain">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header surImage={heroPleinEcran} />
    <main id="contenu" class="mx-auto max-w-5xl px-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>
