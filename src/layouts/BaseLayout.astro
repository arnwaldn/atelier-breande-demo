---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import EchelleKelvins from '../components/EchelleKelvins.astro';
import { horaires as horairesContact } from '../data/contact-infos';

interface Props {
  title: string;
  description: string;
  /** true : l'en-tête se pose SUR le contenu (hero plein écran géré par la
      page elle-même, qui réserve sa propre marge sous l'en-tête). false :
      <main> réserve la hauteur de l'en-tête, pour ne rien couvrir. */
  heroPleinEcran?: boolean;
  /** Props transmises telles quelles à PiedDePage (zone, horaires) — par
      défaut, le résumé issu du référentiel de contact (data/contact-infos.ts),
      identique sur les six pages. */
  piedZone?: string;
  piedHoraires?: string;
}
const {
  title,
  description,
  heroPleinEcran = false,
  piedZone = 'Lyon et la métropole, jusqu’à 60 km, sur rendez-vous',
  piedHoraires = `${horairesContact.semaine} ; ${horairesContact.samedi}`,
} = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <SeoHead title={title} description={description} />
    {/*
      Script classique (jamais type="module", donc jamais différé) qui pose
      html.js AVANT tout rendu du corps de page : c'est de cette classe que
      dépend la hauteur qui confisque le défilement du ruban des gestes
      (voir .ruban-gestes, global.css) — sans elle, aucun script ne traduit
      la piste et le visiteur descendrait des écrans vides devant une image
      immobile. Fichier brut dans public/ (pas src/scripts/) : Astro
      empaquette tout <script src="../scripts/…"> en module différé, ce qui
      arriverait ici APRÈS le premier rendu et produirait exactement le
      décalage de mise en page (CLS) que ce garde-fou doit éviter. is:inline
      laisse la balise telle quelle. CONTENU EN LIGNE depuis le 20/08/2026 :
      le fichier séparé coûtait un aller-retour réseau BLOQUANT mesuré à
      451 ms chez PageSpeed pour 120 octets utiles. Le contenu est autorisé
      par un hash dans la CSP (vercel.json, script-src). Le hash porte sur
      les octets EXACTS entre les balises : toute retouche, même un espace,
      impose de le recalculer avec openssl dgst -sha256 -binary | openssl base64
    */}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="grain">
    {/* LE VARIATEUR, branché (recette DA du 19/08 au soir) — un seul calque,
        posé une fois ici : --part-de-jour n'était lue nulle part dans le
        CSS servi, alimentée à chaque frame par socle.ts pour rien. Voir
        .lueur-verriere, global.css. Avant l'en-tête dans le document : au
        z-index 0 (comme le grain, qui reste au-dessus, à 1), l'ordre du
        DOM n'a pas d'incidence sur l'empilement, mais place le calque le
        plus « de fond » en premier reste le geste le plus lisible. */}
    <div class="lueur-verriere" aria-hidden="true"></div>

    {/* Hors flux, ne pousse jamais le contenu : voir global.css. */}
    <div class="sentinelle-entete" data-sentinelle-entete aria-hidden="true"></div>

    <a class="skip-link" href="#contenu">Aller au contenu</a>

    <EnTete />
    <EchelleKelvins />

    {/*
      LARGEUR : plus de max-w-5xl/px-4 ici. Depuis la vague B, chaque page
      compose elle-même sa largeur — .contenant (108rem, marge-page) pour le
      texte mesuré, <Bandeau> (même plafond, padding-inline nul d'un seul
      côté) pour les images en plein-bord. Un <main> contraint aurait empêché
      toute image de toucher le bord réel de la fenêtre (ADR-002).
    */}
    <main id="contenu" class:list={['w-full', !heroPleinEcran && 'pt-[var(--hauteur-entete)]']}>
      <slot />
    </main>

    <PiedDePage zone={piedZone} horaires={piedHoraires} />

    {/* L'aiguilleur de la couche animée — voir src/scripts/orchestration.ts. */}
    <script>import '../scripts/orchestration';</script>
  </body>
</html>
