---
/**
 * PiedDePage.astro — remplace Footer.astro.
 *
 * Logotype à TAILLE DE TEXTE : le logotype monumental en pied de page est un
 * marqueur de la démo sœur (Maison Vaubrune), explicitement interdit par
 * l'ADR direction artistique — ici, une simple mention en corps de texte.
 *
 * zone/horaires sont des props : ce composant ne connaît aucun contenu
 * métier par lui-même (les données réelles arrivent avec les pages, hors du
 * périmètre de ce chantier), mais reste utilisable dès aujourd'hui grâce à
 * des valeurs par défaut cohérentes avec le PRD.
 */
interface Props {
  zone?: string;
  horaires?: string;
}

const {
  zone = 'Lyon et sa région, sur rendez-vous',
  horaires = 'du mardi au samedi, 9 h – 18 h',
} = Astro.props;

const annee = new Date().getFullYear();

const liens = [
  { href: '/', libelle: 'accueil' },
  { href: '/latelier', libelle: 'l’atelier' },
  { href: '/collections', libelle: 'collections' },
  { href: '/services', libelle: 'services' },
  { href: '/contact', libelle: 'contact' },
] as const;
---

<footer class="pied-de-page">
  <div class="pied-de-page__cadre contenant">
    <div class="pied-de-page__colonnes">
      <div class="pied-de-page__identite">
        <p class="pied-de-page__marque">Atelier Bréande — luminaires sur mesure.</p>
        <p class="pied-de-page__zone">{zone}</p>
        <p class="pied-de-page__horaires">{horaires}</p>
      </div>

      <nav aria-label="Plan du site" class="pied-de-page__plan">
        <p class="etiquette">plan du site</p>
        <ul>
          {
            liens.map((lien) => (
              <li>
                <a href={lien.href}>{lien.libelle}</a>
              </li>
            ))
          }
          <li><a href="/mentions-legales">mentions légales</a></li>
        </ul>
      </nav>

      {/* Remontee en TROISIEME colonne le 20/08/2026. Le pied n'avait que deux
          blocs en space-between sur 1 440 px : 674 px de gouttiere, un vide
          mesure a 640 x 848 px, soit 41,9 % de l'ecran — identique sur les six
          pages, et c'est la derniere image que le visiteur emporte. La mention
          etait en note sous les colonnes ; elle devient une colonne. Elle n'a
          pas bouge d'un mot, elle a change de place : rien n'est invente pour
          remplir, et la garde de fiction la trouve toujours. */}
      <p class="pied-de-page__fiction">
        Site fictif de démonstration — conçu et réalisé par Arnaud Porcel. {annee}.
      </p>
    </div>

    <div class="pied-de-page__halo" aria-hidden="true"></div>
  </div>
</footer>
