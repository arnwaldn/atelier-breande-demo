---
/**
 * CartePiece.astro — carte de la galerie de pièces.
 *
 * Le nom est affiché tel que fourni : c'est à l'appelant (la fiche de pièce,
 * bas de casse par convention du projet) de le composer déjà en bas de
 * casse — ce composant ne force aucune transformation de casse en CSS, qui
 * romprait la citation exacte d'un nom propre.
 *
 * NOM ACCESSIBLE DU LIEN — aria-label explicite (finition 10, chantier bêta
 * du 19/08). Sans lui, le nom accessible du lien concatène tout son contenu
 * DANS L'ORDRE DU BALISAGE : l'alt de la photo (une phrase entière, voir
 * Visuel.astro) PUIS les matières (EtiquetteTechnique) PUIS seulement le nom
 * de la pièce — vérifié au navigateur (aria snapshot) : « Suspension de cage
 * d'escalier : cinq verres… laiton patiné brun · verre soufflé… Traboule à
 * partir de… ». Au clavier ou au lecteur d'écran, l'objet n'est identifié
 * qu'après une phrase entière de matières. aria-label reprend la même
 * information, réordonnée nom d'abord — rien n'est perdu, tout est repris.
 */
import type { ImageMetadata } from 'astro';
import Visuel from './Visuel.astro';
import EtiquetteTechnique from './EtiquetteTechnique.astro';

interface Props {
  nom: string;
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  matieres: string[];
  /** Le montant seul : le composant préfixe « à partir de ». */
  prix: string;
  delaiCourant: string;
  prioritaire?: boolean;
  /** Largeur rendue RÉELLE, qui dépend de la grille hôte. Codée en dur
   *  jusqu'au 20/08/2026, elle annonçait 100vw en mobile ; sur /collections
   *  la grille rend des cartes à 41 % de la largeur, d'où 78 Ko d'images
   *  surdimensionnées mesurés par PageSpeed. Un composant partagé ne peut
   *  pas deviner la grille qui l'accueille : c'est l'appelant qui sait. */
  sizes?: string;
}

const {
  nom,
  href,
  image,
  imageAlt,
  matieres,
  prix,
  delaiCourant,
  prioritaire = false,
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
} = Astro.props;

// Le slug de la fiche, tiré de l'URL plutôt qu'une prop de plus : href vaut
// toujours /collections/<slug> (voir les appelants), et c'est le nom qui
// relie cette carte à l'image de tête de sa fiche pour le SEUL morphing du
// site (view-transition-name partagé, voir [data-piece-photo] global.css).
const slug = href.split('/').filter(Boolean).pop();
---

<a
  href={href}
  class="carte-piece"
  {/* PAS d'aria-label ici. Il en portait un jusqu'au 20/08/2026, pour placer
      le nom de la piece avant ses matieres a l'oreille. Mais il reordonnait ET
      reponctuait : les matieres s'affichent separees par « · » et l'aria-label
      les listait avec des virgules. Le texte VISIBLE n'etait donc plus contenu
      dans le nom accessible, et Lighthouse le signalait sur /collections
      (label-content-name-mismatch) — c'est-a-dire qu'une commande vocale ne
      pouvait pas designer la carte par ce qu'elle affiche. Le nom accessible
      redevient le contenu reel de la carte. */}
  data-prioritaire={prioritaire || undefined}
>
  <span class="carte-piece__cadre" data-piece-photo={slug}>
    <Visuel
      src={image}
      alt={imageAlt}
      prioritaire={prioritaire}
      sizes={sizes}
      class="carte-piece__image"
    />
  </span>
  <span class="carte-piece__corps">
    <EtiquetteTechnique items={matieres} />
    <span class="carte-piece__nom">{nom}</span>
    <span class="carte-piece__specs">
      <span>à partir de {prix}</span>
      <span>{delaiCourant}</span>
    </span>
  </span>
</a>
